generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum Role {
  STUDENT
  ADMIN
  CONTENT_EDITOR
}

enum SatSection {
  READING_WRITING
  MATH
}

// CHOICE — вопрос с вариантами A-D; FILL — пропуски, которые заполняются словами из банка (новый формат урока)
enum QuestionKind {
  CHOICE
  FILL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AnswerCorrectness {
  CORRECT
  INCORRECT
  SKIPPED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

// Интенсивность из онбординга -> цель дня:
// LIGHT = 1 урок, NORMAL = 1 урок + 10 повторений, INTENSE = 2 урока + 10 повторений
enum StudyIntensity {
  LIGHT
  NORMAL
  INTENSE
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String? // nullable — у OAuth-юзеров пароля нет
  fullName      String
  role          Role         @default(STUDENT)
  targetScore   Int?
  age           Int?
  hasTakenSat   Boolean?
  previousScore Int?
  authProvider  AuthProvider @default(LOCAL)
  providerId    String? // sub от Google/Apple
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // ---- геймификация / цель дня ----
  xp              Int            @default(0)
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  lastStreakDate  DateTime?      @db.Date // последний локальный день, когда выполнен минимум
  timezone        String         @default("Asia/Almaty") // IANA, с телефона
  studyIntensity  StudyIntensity @default(NORMAL)
  // ---- подписка (пока ручной флаг; потом выставляет вебхук магазина) ----
  hasSubscription Boolean        @default(false)

  attempts           TestAttempt[]
  aiLogs             AiInteractionLog[]
  answerLogs         AnswerLog[]
  levelProgress      UserLevelProgress[]
  dailyQuotas        DailyQuota[]
  dailyProgress      DailyProgress[]
  mistakeReviewItems MistakeReviewItem[]
  studyPathProgress  StudyPathProgress[]

  @@unique([authProvider, providerId])
  @@map("users")
}

// ---------- FULL TESTS ----------

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  isAdaptive  Boolean  @default(true)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  modules  TestModule[]
  attempts TestAttempt[]

  @@map("tests")
}

model TestModule {
  id           String              @id @default(cuid())
  testId       String
  section      SatSection
  order        Int
  difficulty   QuestionDifficulty?
  timeLimitSec Int

  test      Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions QuestionOnModule[]

  @@index([testId])
  @@map("test_modules")
}

// ---------- QUESTIONS ----------

model Question {
  id                 String             @id @default(cuid())
  section            SatSection
  level              Int
  orderInLevel       Int
  difficulty         QuestionDifficulty
  kind               QuestionKind       @default(CHOICE)
  title              String? // заголовок карточки, напр. "Заполни пропуски"
  stem               String             @db.Text // для FILL — текст с "___" вместо пропусков (для тьютора/админки)
  // ---- CHOICE ----
  choiceA            String?
  choiceB            String?
  choiceC            String?
  choiceD            String?
  correctChoice      String?
  // ---- FILL ----
  parts              Json? // (string | null)[]: текст, null = пропуск, "\n" = перенос
  options            Json? // string[]: банк слов/чисел
  answers            Json? // number[]: для каждого пропуска по порядку — индекс в options
  // ---- объяснение ----
  explanation        String             @db.Text // плоский текст (для всех видов)
  explainRule        String? // короткое правило в заголовке
  explainParagraphs  Json? // string[]
  explainExamples    Json? // string[]
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  domain             String?
  domainLevel        Int?
  domainOrderInLevel Int?

  tags               QuestionTag[]
  modules            QuestionOnModule[]
  answerLogs         AnswerLog[]
  aiLogs             AiInteractionLog[]
  mistakeReviewItems MistakeReviewItem[]

  @@unique([section, level, orderInLevel])
  @@map("questions")
}

model Tag {
  id       String @id @default(cuid())
  name     String @unique
  category String

  questions QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model QuestionOnModule {
  testModuleId String
  questionId   String
  order        Int

  testModule TestModule @relation(fields: [testModuleId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testModuleId, questionId])
  @@map("questions_on_modules")
}

// ---------- LEVEL PROGRESSION (checkpoint / test mode, 50+50) ----------

model UserLevelProgress {
  id           String     @id @default(cuid())
  userId       String
  section      SatSection
  currentLevel Int        @default(1)
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, section])
  @@map("user_level_progress")
}

model DailyQuota {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime  @db.Date
  mathAnswered Int       @default(0)
  rwAnswered   Int       @default(0)
  mathTarget   Int       @default(15)
  rwTarget     Int       @default(15)
  completed    Boolean   @default(false)
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_quotas")
}

// ---------- DOMAIN PROGRESSION (учебный режим, по темам) ----------
model StudyPathProgress {
  id                   String   @id @default(cuid())
  userId               String   @unique
  currentSequenceLevel Int      @default(1)
  mathTabDone          Boolean  @default(false)
  grammarTabDone       Boolean  @default(false)
  unlockedModules      Int      @default(1) // модуль = 5 уровней; следующий открывается кнопкой "РАЗБЛОКИРОВАТЬ"
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("study_path_progress")
}

// ---------- ЦЕЛЬ ДНЯ (заменяет DailyQuota) ----------
model DailyProgress {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date // локальная дата по User.timezone
  lessonsCompleted Int      @default(0) // урок = один пройденный таб (math или grammar)
  reviewAnswered   Int      @default(0)
  reviewSessions   Int      @default(0)
  lessonTarget     Int      @default(1)
  reviewTarget     Int      @default(10)
  minimumMet       Boolean  @default(false) // 1 урок ИЛИ 10 повторений -> серия
  goalMet          Boolean  @default(false) // полная цель -> бонус XP
  xpEarned         Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_progress")
}

// ---------- ATTEMPTS ----------

model TestAttempt {
  id          String        @id @default(cuid())
  userId      String
  testId      String
  status      AttemptStatus @default(IN_PROGRESS)
  scoreRW     Int?
  scoreMath   Int?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  user       User        @relation(fields: [userId], references: [id])
  test       Test        @relation(fields: [testId], references: [id])
  answerLogs AnswerLog[]

  @@index([userId])
  @@map("test_attempts")
}

model AnswerLog {
  id           String            @id @default(cuid())
  attemptId    String
  userId       String
  questionId   String
  userAnswer   String
  correctness  AnswerCorrectness
  timeSpentSec Int
  createdAt    DateTime          @default(now())

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@index([userId, questionId])
  @@index([userId, createdAt])
  @@map("answer_logs")
}

// ---------- AI PIPELINE ----------

model AiInteractionLog {
  id                 String   @id @default(cuid())
  userId             String
  questionId         String?
  prompt             String   @db.Text
  rawResponse        String   @db.Text
  finalResponse      String   @db.Text
  modelName          String
  mathVerified       Boolean  @default(false)
  verificationPassed Boolean?
  flaggedForReview   Boolean  @default(false)
  latencyMs          Int?
  createdAt          DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])

  @@index([userId])
  @@index([flaggedForReview])
  @@map("ai_interaction_logs")
}

// ---------- MISTAKE REVIEW ----------

model MistakeReviewItem {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  timesWrong    Int       @default(1)
  correctStreak Int       @default(0) // верно подряд; при 2 задача уходит из списка
  resolved      Boolean   @default(false)
  lastWrongAt   DateTime  @default(now())
  resolvedAt    DateTime?

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@map("mistake_review_items")
}

model LessonScenario {
  id          String   @id @default(cuid())
  domain      String // "algebra", "advanced_math" и т.д.
  domainLevel Int // 1-8 для algebra, 1-9 для advanced_math и т.д. (свой счётчик внутри домена)
  order       Int // 1-7 порядок сценария внутри урока
  title       String
  content     String   @db.Text // сам текст объяснения "как решается"
  createdAt   DateTime @default(now())

  @@unique([domain, domainLevel, order])
  @@map("lesson_scenarios")
}
