DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
ANTHROPIC_API_KEY="sk-ant-xxxx"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
APPLE_CLIENT_ID="com.yourapp.bundleid"

# Часовой пояс по умолчанию (если телефон не прислал свой)
DEFAULT_TIMEZONE="Asia/Almaty"
# true = вход в следующий модуль только после кнопки "РАЗБЛОКИРОВАТЬ" (включить, когда фронт её получит)
STUDY_REQUIRE_MODULE_UNLOCK="false"
